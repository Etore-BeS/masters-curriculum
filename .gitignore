courses/ft108a-machine-learning/exercises/03-naive-bayes-knn-ensembles-liver/code/report-body.md
courses/ft108a-machine-learning/exercises/03-naive-bayes-knn-ensembles-liver/code/notebook.tex

# OS and editors
.DS_Store
*.swp
.idea/
.vscode/

# Course deliveries and generated partitions
courses/*/entregas/**
!courses/*/entregas/README.md
!courses/*/entregas/.gitkeep
courses/*/exercises/*/code/partitions/**
!courses/*/exercises/*/code/partitions/.gitkeep
courses/*/exercises/*/code/*.pdf
courses/*/exercises/*/code/*.zip
courses/*/exercises/*/code/*_files/
courses/*/exercises/*/code/*.tex
courses/*/exercises/*/code/*.aux
courses/*/exercises/*/code/*.log
courses/*/exercises/*/code/*.out

# Course data: keep README tracked; ignore raw/processed binaries
courses/*/data/raw/
courses/*/data/processed/
!courses/*/data/README.md

# Exploratory viz HTML / Quarto intermediates (regenerable)
courses/ft105a-information-visualization/project/*/code/output/
courses/ft105a-information-visualization/project/*/code/.quarto/
courses/ft105a-information-visualization/project/*/code/*_files/
