# Admin: personal and enrollment data (never commit)
admin/facts.md
admin/documents/

# Course materials: keep PDFs and slides local only
courses/*/materials/**
!courses/*/materials/README.md

# Paper PDFs: bibliographic records stay in git
references/papers/**
!references/papers/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ruff_cache/

# R
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Jupyter
.ipynb_checkpoints/

# FT108A: local deliveries and generated exercise artifacts
courses/ft108a-machine-learning/entregas/**
!courses/ft108a-machine-learning/entregas/README.md
!courses/ft108a-machine-learning/entregas/.gitkeep
courses/ft108a-machine-learning/exercises/*/code/*.pdf
courses/ft108a-machine-learning/exercises/*/code/*.zip
courses/ft108a-machine-learning/exercises/*/code/partitions/
courses/ft108a-machine-learning/exercises/*/code/*.tex
courses/ft108a-machine-learning/exercises/*/code/*.aux
courses/ft108a-machine-learning/exercises/*/code/*.log
courses/ft108a-machine-learning/exercises/*/code/*.out
courses/ft108a-machine-learning/exercises/*/code/*_files/
